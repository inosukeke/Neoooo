# Copy nội dung file này vào .env.local: NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# (file .env.local bị chặn ghi trực tiếp bởi permission sandbox của Claude Code
# trong phiên này nên để tên khác đây — bạn tự tạo .env.local từ nội dung này.)
#
# URL backend FastAPI (src/api/main.py). NEXT_PUBLIC_* lộ ra trình duyệt —
# không để secret ở đây, chỉ cấu hình host:port.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
